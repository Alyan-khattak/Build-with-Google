# AMANAH AI — environment variable template
# Copy this file to .env and fill in real values. Never commit .env.

# Backend
SECRET_KEY=change-this-to-a-long-random-string-at-least-32-chars
DATABASE_URL=sqlite:///./data/amanah.db

# Optional — P1 features (leave empty to skip gracefully)
GEMINI_API_KEY=

# Email notifications via SMTP (leave SMTP_HOST empty to disable)
# Example for Gmail: use an App Password, not your account password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AMANAH AI <noreply@yourdomain.com>

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Check-in timing (override for a faster demo; production values shown)
FIRST_CHECK_MINUTES=5
CHECK_INTERVAL_MINUTES=3
RESPONSE_WINDOW_SECONDS=60
MAX_CHECKS_PER_SESSION=20
